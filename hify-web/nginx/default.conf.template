server {
    listen 80;
    server_name _;

    # 未来知识库文档上传预留（当前虽无上传接口，先配好避免现场再改）
    client_max_body_size 50m;

    # ---------- /api 反代到后端（含 SSE） ----------
    location /api/ {
        # ${NGINX_BACKEND_HOST} 由官方 nginx 镜像启动脚本 envsubst 替换，默认 hify-backend:8080
        proxy_pass http://${NGINX_BACKEND_HOST};

        # 常规透传
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE 必须：关闭响应缓冲，delta 实时下发，不攒批不等待
        proxy_buffering off;
        proxy_cache off;
        # 请求体同样不缓冲到临时文件，保持流式语义
        proxy_request_buffering off;
        # 不向 HTTP/1.1 后端声明 Connection: close，长连接由后端按 SSE 生命周期收尾
        proxy_set_header Connection      "";

        # 长耗时 LLM/SSE：读超时对齐 CLAUDE.md Ingress 的 300s（后端 SseEmitter 200s + 余量）
        proxy_connect_timeout 10s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
    }

    # ---------- Vue history 路由：未命中静态文件回退 index.html ----------
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
