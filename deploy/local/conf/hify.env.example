# ============================================================
# Hify 部署环境变量示例
# 用法：cp hify.env.example hify.env，按现场环境修改；bin/start.sh 自动加载。
# 注意：已 export 的环境变量优先级高于本文件；本文件不要提交真实口令。
# ============================================================

# 服务端口
HIFY_SERVER_PORT=8080

# Spring profile：留空=可读文本日志（本地排查）；
# K8s/Docker 等由日志 Agent 采集 stdout 的环境设为 prod，输出 JSON 单行日志（含 traceId）
# SPRING_PROFILES_ACTIVE=prod

# MySQL（外部必备；库需提前创建并导入各模块 db/schema.sql）
HIFY_MYSQL_HOST=127.0.0.1
HIFY_MYSQL_PORT=3306
HIFY_MYSQL_DATABASE=hify
HIFY_MYSQL_USER=hify
HIFY_MYSQL_PASSWORD=hify123

# Redis（本期为预留依赖，未实际使用，可留空不部署）
HIFY_REDIS_HOST=127.0.0.1
HIFY_REDIS_PORT=6379
HIFY_REDIS_DATABASE=0
# HIFY_REDIS_PASSWORD=

# pgvector（知识库模块上线前不使用，可留空不部署）
HIFY_PGVECTOR_HOST=127.0.0.1
HIFY_PGVECTOR_PORT=5432
HIFY_PGVECTOR_DATABASE=hify_vector
HIFY_PGVECTOR_USER=hify
# HIFY_PGVECTOR_PASSWORD=

# 前端静态目录（默认包内 dist，一般无需修改）
# HIFY_WEB_DIR=/opt/hify/dist

# 追加 JVM 参数（如固定 Xmx：-Xmx512m；出网代理：-Dhttps.proxyHost=... -Dhttps.proxyPort=...）
# JAVA_OPTS_EXTRA=-Xmx512m
